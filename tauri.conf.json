{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitCrab",
  "version": "0.1.0",
  "identifier": "com.manusfv.gitcrab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "dist/frontend",
    "features": ["desktop"]
  },
  "app": {
    "windows": [
      {
        "title": "GitCrab",
        "width": 1172,
        "height": 636,
        "minWidth": 800,
        "minHeight": 500,
        "backgroundColor": "#1c1e23"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": [
        { "identifier": "main", "windows": ["main"], "permissions": [] }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Independent local Git desktop client",
    "category": "DeveloperTool",
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
